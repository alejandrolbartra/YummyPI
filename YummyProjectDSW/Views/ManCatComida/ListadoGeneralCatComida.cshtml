@model IEnumerable<yummyApp.Models.ManComida>

@{
    ViewData["Title"] = "Listado General Categoria Comida";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 text-primary">@ViewData["Title"]</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva categoría
        </a>
    </div>
    
    <!-- Filtro -->
    <form asp-action="ListadoGeneralCatComida" asp-controller="ManCatComida" class="row g-3 align-items-end mb-4">
        <div class="col-md-3">
            <label for="numreg" class="form-label">Cantidad de registros</label>
            <input type="number" name="numreg" id="numreg" value="@ViewBag.numreg" min="1" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
        </div>
    </form>

    <!-- Tabla -->
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.idCategoriaComida)</th>
                    <th>@Html.DisplayNameFor(model => model.nombreCategoriaComida)</th>

                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.idCategoriaComida)</td>
                        <td>@Html.DisplayFor(modelItem => item.nombreCategoriaComida)</td>

                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.idCategoriaComida" class="btn btn-sm btn-warning me-1">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a asp-action="Details" asp-route-id="@item.idCategoriaComida" class="btn btn-sm btn-info me-1">
                                <i class="bi bi-eye"></i> Detalles
                            </a>

                            <form asp-action="Delete" asp-route-id="@item.idCategoriaComida" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Seguro que deseas eliminar esta categoría?');">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a asp-controller="Home" asp-action="ManGeneral" class="btn btn-outline-secondary">← Volver</a>
    </div>

    <!-- Paginando -->
    @if ((int)ViewBag.pags > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 0; i < (int)ViewBag.pags; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.page ? "active" : "")">
                        <a class="page-link"
                           asp-action="ListadoGeneralCatComida"
                           asp-route-numreg="@ViewBag.numreg"
                           asp-route-page="@i">
                            @(i + 1)
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
