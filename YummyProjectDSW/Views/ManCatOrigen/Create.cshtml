@model yummyApp.Models.CategoriaOrigen

@{
    ViewData["Title"] = "Crear Categoría de Origen";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="nombreCategoriaOrigen" class="form-label"></label>
                    <input asp-for="nombreCategoriaOrigen" class="form-control" />
                    <span asp-validation-for="nombreCategoriaOrigen" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <input asp-for="estado" type="hidden" value="1" />
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="ListadoGeneralCatOrigen" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Volver al listado
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Crear
                    </button>
                </div>
            </form>
        </div>

        <div class="card-footer text-muted">
            @ViewBag.mensaje
            <div class="mt-2">
                <a asp-controller="ManProducto" asp-action="ListadoGeneralProductos"></a>
            </div>
        </div>


    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

