@model yummyApp.Models.CategoriaOrigen

@{
    ViewData["Title"] = "Detalles de Categoría de Origen";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0"><i class="bi bi-eye"></i> @ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 fw-bold">
                    @Html.DisplayNameFor(model => model.idCategoriaOrigen)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.idCategoriaOrigen)
                </dd>

                <dt class="col-sm-3 fw-bold">
                    @Html.DisplayNameFor(model => model.nombreCategoriaOrigen)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.nombreCategoriaOrigen)
                </dd>

                
            </dl>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="ListadoGeneralCatOrigen" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver al listado
            </a>
            <a asp-action="Edit" asp-route-id="@Model.idCategoriaOrigen" class="btn btn-warning">
                <i class="bi bi-pencil-square"></i> Editar
            </a>
        </div>
    </div>
</div>