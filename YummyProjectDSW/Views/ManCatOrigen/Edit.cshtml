@model yummyApp.Models.CategoriaOrigen

@{
    ViewData["Title"] = "Editar Categoría de Origen";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> @ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="idCategoriaOrigen" class="form-label"></label>
                    <input asp-for="idCategoriaOrigen" class="form-control" readonly />
                    <span asp-validation-for="idCategoriaOrigen" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="nombreCategoriaOrigen" class="form-label"></label>
                    <input asp-for="nombreCategoriaOrigen" class="form-control" />
                    <span asp-validation-for="nombreCategoriaOrigen" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="ListadoGeneralCatOrigen" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Volver al listado
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}